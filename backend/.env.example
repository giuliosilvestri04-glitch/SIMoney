# ============================================================
# PROTOTIPO — configurazione backend
# Copiare questo file in `.env` prima del primo avvio.
# NON inserire qui credenziali reali, chiavi Guardian o segreti aziendali.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Origini consentite per CORS. "*" va bene per la demo locale.
CORS_ORIGIN=*
LOG_LEVEL=info

# --- Database (SQLite, file locale: nessun servizio da installare) ---
# Il percorso è relativo alla cartella `prisma/`.
DATABASE_URL="file:./dev.db"

# --- Autenticazione ---
# Segreti SOLO per il prototipo: sostituirli con valori casuali propri.
# Generare con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=prototype-access-secret-change-me-0000000000000000
JWT_REFRESH_SECRET=prototype-refresh-secret-change-me-1111111111111111
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=30

# Password condivisa dagli account demo generati dal seed.
DEMO_PASSWORD=Demo1234!

# --- Sorgente dati ---
# mock     = database del prototipo (DEFAULT, funziona senza Guardian)
# guardian = provider di integrazione futura (NON disponibile in questo prototipo)
DATA_PROVIDER=mock

# --- Guardian (integrazione FUTURA — lasciare vuoto) ---
# Nessun endpoint è stato inventato: questi campi esistono solo come predisposizione.
GUARDIAN_BASE_URL=
GUARDIAN_API_KEY=
GUARDIAN_TIMEOUT_MS=8000

# --- Dati mock (dimensioni del seed) ---
SEED_ADVISORS=5
SEED_CLIENTS=20
SEED_HISTORY_DAYS=730
SEED_RANDOM_SEED=20260911

# --- Documenti fittizi ---
STORAGE_DIR=./storage
